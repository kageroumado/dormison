MODULE    = winemac.drv
UNIXLIB   = winemac.so
IMPORTS   = uuid rpcrt4 user32 gdi32 win32u
DELAYIMPORTS = advapi32 ole32 shell32 imm32
UNIX_LIBS    = \
	-lwin32u \
	-framework AppKit \
	-framework Carbon \
	-framework CoreVideo \
	-framework Foundation \
	-framework IOKit \
	-framework Metal \
	-weak_framework MetalFX \
	-framework OpenGL \
	-framework QuartzCore \
	-framework Security \
	$(srcdir)/swift/libwinemacswift.a \
	-L/usr/lib/swift \
	-lswiftCore \

VER_FILEDESCRIPTION_STR = "Wine Mac driver"

SOURCES = \
	clipboard.c \
	cocoa_app.m \
	cocoa_clipboard.m \
	cocoa_cursorclipping.m \
	cocoa_display.m \
	cocoa_event.m \
	cocoa_main.m \
	cocoa_opengl.m \
	cocoa_status_item.m \
	cocoa_window.m \
	display.c \
	d3dmetal.c \
	d3dmetal_objc.m \
	dllmain.c \
	event.c \
	gdi.c \
	image.c \
	keyboard.c \
	macdrv_main.c \
	mouse.c \
	opengl.c \
	sevo_limiter.c \
	sevo_provenance.c \
	sevo_uma.c \
	sevo_stats.c \
	sevo_sysstats.m \
	surface.c \
	systray.c \
	vulkan.c \
	window.c \
	winemac.rc
