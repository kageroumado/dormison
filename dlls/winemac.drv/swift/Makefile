# The driver's Swift half, built into a static archive that winemac.so links.
#
# Wine's makefiles do not know Swift, so this is a plain makefile run on its
# own, before wine's `make`: `libwinemacswift.a` must exist at the winemac.so
# link. tools/makedep makes the archive a prerequisite of winemac.so, so a
# newer archive relinks the driver at wine's next `make`
# (build-macos/README.md).
#
# The archive carries a build id, `sevo:winemacswift=<16 hex>`, the sha256 of
# these sources and this makefile: the same sources give the same id whenever
# they are built. BuildID.swift is generated from it and exports the id to the
# driver, which prints it in its `sevo:run` line, and
# build-macos/package-engine.sh refuses a staged winemac.so whose id is not
# the archive's.
#
# The target triple matches the engine's: x86_64, deployment target 14. The
# Swift runtime is in the dyld shared cache in both slices, so nothing ships
# alongside the archive.

SWIFTC ?= swiftc
TARGET ?= x86_64-apple-macos14
SOURCES = Presenter.swift SurfacePresenter.swift GLPresenter.swift FinalPass.swift Scalers.swift MPVHook.swift
BUILD_ID = $(shell cat $(SOURCES) Makefile | shasum -a 256 | cut -c1-16)

libwinemacswift.a: $(SOURCES) BuildID.swift
	$(SWIFTC) -emit-library -static -target $(TARGET) -O -parse-as-library \
	    -module-name WineMacSwift -o $@ $(SOURCES) BuildID.swift

BuildID.swift: $(SOURCES) Makefile
	printf '%s\n' \
	    '// Generated by the makefile: the build id of this archive, the sha256' \
	    '// prefix of the Swift sources and the makefile. The driver prints it' \
	    '// and package-engine.sh pairs the archive with the winemac.so that' \
	    '// carries the same string.' \
	    'private let buildID: StaticString = "sevo:winemacswift=$(BUILD_ID)"' \
	    '' \
	    '/// The build id as a C string, for the `sevo:run` line and the packaging gate.' \
	    '@_cdecl("sevo_winemacswift_build_id")' \
	    'public func sevoWineMacSwiftBuildID() -> UnsafePointer<CChar> {' \
	    '    UnsafeRawPointer(buildID.utf8Start).assumingMemoryBound(to: CChar.self)' \
	    '}' > $@

build-id:
	@echo sevo:winemacswift=$(BUILD_ID)

clean:
	rm -f libwinemacswift.a BuildID.swift WineMacSwift.swiftmodule WineMacSwift.swiftdoc

.PHONY: build-id clean
